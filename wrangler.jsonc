{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-5m-dashboard",
  "main": "coinglass-worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
